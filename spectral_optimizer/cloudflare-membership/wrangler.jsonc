{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spectral-optimizer-members",
  "main": "worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-07-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "sp.shaowt.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "MEMBERS",
      "database_name": "spectral-members",
      "database_id": "6821cca9-7356-4ad7-b41d-444dd372c4c8"
    }
  ]
}
